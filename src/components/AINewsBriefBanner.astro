---
/**
 * AI 日报横幅组件
 * 可嵌入首页或其他页面，展示最新早报/晚报入口
 *
 * 使用方式：
 *   <AINewsBriefBanner morning={...} evening={...} />
 *
 * Props:
 *   morning — 最新早报对象（含 data: { title, date, newsCount, status, briefType },
 *            slug, collection）
 *   evening — 最新晚报对象，结构同上
 */
import { formatDate } from '@utils/formatDate';

interface Brief {
  data: {
    title: string;
    date: string;
    description?: string;
    newsCount?: number;
    status?: string;
    briefType?: string;
  };
  slug: string;
  collection: string;
}

interface Props {
  morning?: Brief | null;
  evening?: Brief | null;
}

const { morning, evening } = Astro.props;
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';

function briefTypeLabel(brief?: Brief | null): string {
  return brief?.data.briefType === 'evening' ? '晚报' : '早报';
}

function statusText(brief?: Brief | null): string {
  if (!brief) { return '暂无简报'; }
  const s = brief.data.status || 'published';
  if (s === 'draft' || s === 'review') { return '待审核'; }
  return '已更新';
}

function statusClass(brief?: Brief | null): string {
  if (!brief) { return 'banner-status-empty'; }
  const s = brief.data.status || 'published';
  if (s === 'draft' || s === 'review') { return 'banner-status-review'; }
  return 'banner-status-published';
}

function summaryText(brief?: Brief | null): string {
  return brief?.data.description?.trim() || '暂无中文摘要';
}

const hasMorning = !!morning;
const hasEvening = !!evening;
---

{
  (hasMorning || hasEvening) && (
    <div class="daily-brief-banner">
      <div class="banner-header">
        <div>
          <p class="banner-kicker">AI 行业日报</p>
          <h2 class="banner-title">早报 / 晚报</h2>
        </div>
        <span class="banner-hint">中文摘要 · 站点聚合</span>
      </div>
      <div class="banner-cards">
        {
          hasMorning && (
            <a
              href={`${base}${morning!.collection}/${morning!.slug}/`}
              class="banner-card banner-card--morning"
            >
              <div class="banner-card-top">
                <span class="banner-card-icon">🌅</span>
                <span class="banner-card-label">早报</span>
                <span class={`banner-card-status ${statusClass(morning)}`}>
                  {statusText(morning)}
                </span>
              </div>
              <h3 class="banner-card-title">{morning!.data.title}</h3>
              <p class="banner-card-summary">{summaryText(morning)}</p>
              <div class="banner-card-meta">
                <span>📅 {formatDate(morning!.data.date)}</span>
                <span>📊 {morning!.data.newsCount || 0} 条</span>
              </div>
            </a>
          )
        }
        {
          hasEvening && (
            <a
              href={`${base}${evening!.collection}/${evening!.slug}/`}
              class="banner-card banner-card--evening"
            >
              <div class="banner-card-top">
                <span class="banner-card-icon">🌇</span>
                <span class="banner-card-label">晚报</span>
                <span class={`banner-card-status ${statusClass(evening)}`}>
                  {statusText(evening)}
                </span>
              </div>
              <h3 class="banner-card-title">{evening!.data.title}</h3>
              <p class="banner-card-summary">{summaryText(evening)}</p>
              <div class="banner-card-meta">
                <span>📅 {formatDate(evening!.data.date)}</span>
                <span>📊 {evening!.data.newsCount || 0} 条</span>
              </div>
            </a>
          )
        }
      </div>
    </div>
  )
}

<style>
  .daily-brief-banner {
    background: #fff;
    border-radius: 8px;
    border: 1px solid var(--color-border-light);
    padding: 1rem 1.1rem;
    margin-bottom: var(--spacing-lg);
  }

  .banner-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-md);
    margin-bottom: 1rem;
  }

  .banner-kicker {
    font-size: 0.8rem;
    color: var(--color-text-light);
    margin-bottom: 0.15rem;
  }

  .banner-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .banner-hint {
    font-size: 0.78rem;
    color: var(--color-text-light);
  }

  .banner-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
  }

  .banner-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem;
    background: #fff;
    border-radius: 8px;
    border: 1px solid var(--color-border-light);
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    min-width: 0;
  }

  .banner-card:hover {
    box-shadow: var(--shadow-sm);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .banner-card-top {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .banner-card-icon {
    font-size: 1rem;
  }

  .banner-card-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .banner-card-title {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.45;
    min-height: 2.9em;
  }

  .banner-card-status {
    margin-left: auto;
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: 8px;
    font-weight: 500;
  }

  .banner-card-summary {
    color: var(--color-text-light);
    font-size: 0.84rem;
    line-height: 1.65;
    min-height: 3.2em;
  }

  .banner-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--color-text-light);
    font-size: 0.78rem;
  }

  .banner-status-published {
    background-color: #e6fffa;
    color: #234e52;
  }

  .banner-status-review {
    background-color: #fefcbf;
    color: #744210;
  }

  .banner-status-empty {
    background-color: #edf2f7;
    color: #718096;
  }

  @media (max-width: 760px) {
    .banner-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .banner-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
