---
/**
 * 顶部导航栏组件
 * 包含网站名称和导航菜单，手机端自动折叠为汉堡菜单
 */
import { navItems } from '@config/nav';
import { siteConfig } from '@config/site';

// 获取当前页面路径，用于高亮当前导航项
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <!-- 网站名称 -->
    <a href="/" class="site-logo" aria-label="返回首页">
      {siteConfig.title}
    </a>

    <!-- 桌面端导航菜单 -->
    <nav class="site-nav" aria-label="主导航">
      {
        navItems.map((item) => {
          // 判断当前页面是否匹配该导航项
          const isActive = currentPath === item.href
            || (item.href !== '/' && currentPath.startsWith(item.href));

          return (
            <a
              href={item.href}
              class={`nav-link${isActive ? ' nav-link--active' : ''}`}
            >
              {item.text}
            </a>
          );
        })
      }
    </nav>

    <!-- 手机端菜单按钮 -->
    <button
      class="mobile-menu-btn"
      id="mobileMenuBtn"
      aria-label="打开菜单"
      aria-expanded="false"
    >
      <span class="menu-icon-bar"></span>
      <span class="menu-icon-bar"></span>
      <span class="menu-icon-bar"></span>
    </button>
  </div>

  <!-- 手机端下拉菜单 -->
  <nav class="mobile-nav" id="mobileNav" aria-label="移动端导航">
    {
      navItems.map((item) => {
        const isActive = currentPath === item.href
          || (item.href !== '/' && currentPath.startsWith(item.href));

        return (
          <a
            href={item.href}
            class={`mobile-nav-link${isActive ? ' mobile-nav-link--active' : ''}`}
          >
            {item.text}
          </a>
        );
      })
    }
  </nav>
</header>

<style>
  /* ---------- 导航栏容器 ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-header);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border-light);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  /* ---------- 网站名称 ---------- */
  .site-logo {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-logo:hover {
    color: var(--color-primary);
  }

  /* ---------- 桌面导航 ---------- */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-link {
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
    color: var(--color-text-light);
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-primary);
    background-color: var(--color-primary-light);
  }

  .nav-link--active {
    color: var(--color-primary);
    font-weight: 600;
    background-color: var(--color-primary-light);
  }

  /* ---------- 手机菜单按钮 ---------- */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .mobile-menu-btn:hover {
    background-color: var(--color-border-light);
  }

  .menu-icon-bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu-btn.open .menu-icon-bar:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-btn.open .menu-icon-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.open .menu-icon-bar:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* ---------- 手机下拉菜单 ---------- */
  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 0 var(--spacing-md) var(--spacing-md);
    background: var(--color-bg-header);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border-light);
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-nav-link {
    padding: 0.7rem var(--spacing-md);
    font-size: 0.95rem;
    color: var(--color-text-light);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }

  .mobile-nav-link:hover {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
  }

  .mobile-nav-link--active {
    color: var(--color-primary);
    font-weight: 600;
    background-color: var(--color-primary-light);
  }

  /* ---------- 响应式 ---------- */
  @media (max-width: 700px) {
    .site-nav {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>

<script>
  // 手机端菜单展开/折叠逻辑
  const btn = document.getElementById('mobileMenuBtn');
  const nav = document.getElementById('mobileNav');

  if (btn && nav) {
    btn.addEventListener('click', () => {
      const isOpen = nav.classList.contains('open');
      if (isOpen) {
        nav.classList.remove('open');
        btn.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', '打开菜单');
      } else {
        nav.classList.add('open');
        btn.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', '关闭菜单');
      }
    });
  }
</script>
