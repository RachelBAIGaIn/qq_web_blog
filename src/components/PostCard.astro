---
/**
 * 文章卡片组件
 * 在列表页展示单篇文章的预览信息：封面图、标题、日期、摘要、标签
 *
 * 使用方式：
 *   <PostCard post={文章数据对象} collection="life" />
 */
import TagList from '@components/TagList.astro';
import { formatDate } from '@utils/formatDate';

interface Props {
  title: string;
  date: string;
  description?: string;
  cover?: string;
  category?: string;
  tags?: string[];
  slug: string;
  collection: string;
}

const {
  title,
  date,
  description,
  cover,
  category,
  tags = [],
  slug,
  collection,
} = Astro.props;

// base 路径：开发时为 /，Gitee Pages 部署时为 /QQ_Web_Blog/
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';
// 文章的完整链接
const postUrl = `${base}${collection}/${slug}/`;
---

<article class="post-card">
  <!-- 封面图 -->
  {
    cover && (
      <a href={postUrl} class="post-card-cover" aria-hidden="true" tabindex="-1">
        <img src={`${base}${cover.replace(/^\//, '')}`} alt={title} loading="lazy" />
      </a>
    )
  }

  <!-- 卡片正文 -->
  <div class="post-card-body">
    <div class="post-card-meta">
      {
        category && <span class="post-card-category">{category}</span>
      }
      <time class="post-card-date" datetime={date}>
        {formatDate(date)}
      </time>
    </div>

    <h3 class="post-card-title">
      <a href={postUrl}>{title}</a>
    </h3>

    {
      description && (
        <p class="post-card-desc">{description}</p>
      )
    }

    {
      tags.length > 0 && (
        <div class="post-card-tags">
          <TagList tags={tags} />
        </div>
      )
    }

    <a href={postUrl} class="post-card-readmore">
      阅读全文 →
    </a>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg);
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
    transition: all 0.25s ease;
  }

  .post-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  /* ---------- 封面图 ---------- */
  .post-card-cover {
    flex-shrink: 0;
    width: 220px;
    height: 150px;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card-cover img {
    transform: scale(1.05);
  }

  /* ---------- 正文区域 ---------- */
  .post-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .post-card-category {
    font-size: 0.8rem;
    padding: 0.15rem 0.5rem;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 20px;
  }

  .post-card-date {
    font-size: 0.8rem;
    color: var(--color-text-lighter);
  }

  .post-card-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .post-card-title a {
    color: var(--color-text);
  }

  .post-card-title a:hover {
    color: var(--color-primary);
  }

  .post-card-desc {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 0.5rem;
    /* 最多显示两行 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-tags {
    margin-top: auto;
    margin-bottom: 0.5rem;
  }

  .post-card-readmore {
    font-size: 0.85rem;
    font-weight: 500;
    align-self: flex-start;
  }

  /* ---------- 手机端适配 ---------- */
  @media (max-width: 600px) {
    .post-card {
      flex-direction: column;
      gap: var(--spacing-md);
    }

    .post-card-cover {
      width: 100%;
      height: 180px;
    }
  }
</style>
