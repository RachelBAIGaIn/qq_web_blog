---
/**
 * 文章详情页布局
 * 为文章详情提供统一的展示框架，包含标题、元信息、正文和导航
 */
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import TagList from '@components/TagList.astro';
import { siteConfig } from '@config/site';
import { formatDate, estimateReadTime } from '@utils/formatDate';
import '@styles/global.css';
import '@styles/article.css';

// base 路径：开发时为 /，Gitee Pages 部署时为 /qq_web_blog/
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';

interface Props {
  title: string;
  date: string;
  description?: string;
  category?: string;
  tags?: string[];
  cover?: string;
  collection: string;
  isDailyBrief?: boolean;
  briefType?: 'morning' | 'evening';
  newsCount?: number;
  status?: string;
}

const {
  title,
  date,
  description,
  category,
  tags = [],
  cover,
  collection,
  isDailyBrief = false,
  briefType,
  newsCount,
  status,
} = Astro.props;

// 计算阅读时间（用页面的正文内容）
const bodyText = await Astro.slots.render('default');
const readTime = estimateReadTime(bodyText);

// 板块名称映射
const collectionNames: Record<string, string> = {
  life: '个人生活分享',
  'ai-news': 'AI 相关资讯',
  skills: '个人技能学习',
  projects: '项目实战展示',
};

const collectionName = collectionNames[collection] || collection;
const fullTitle = `${title} - ${siteConfig.title}`;
const isAiBrief = collection === 'ai-news' && isDailyBrief;
const briefTypeLabel = briefType === 'evening' ? '晚报' : '早报';
const briefStatusLabel = status === 'draft' || status === 'review' ? '待审核' : '已发布';
const metaDescription = description || title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <title>{fullTitle}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>"
    />
  </head>
  <body>
    <Header />

    <main class="page-main">
      <article class="container">
        <!-- 返回列表链接 -->
        <div style="margin-bottom: 1.5rem;">
          <a href={`${base}${collection}/`} class="btn btn-outline" style="font-size: 0.85rem;">
            ← 返回{collectionName}
          </a>
        </div>

        <!-- 文章头部信息 -->
        <header class={isAiBrief ? 'brief-hero' : 'article-hero'} style="margin-bottom: 2rem;">
          <!-- 文章封面图 -->
          {
            cover && (
              <img
                src={`${base}${cover.replace(/^\//, '')}`}
                alt={title}
                style="max-height: 360px; width: 100%; object-fit: cover;
                  border-radius: var(--radius-md); margin-bottom: 1.5rem;"
              />
            )
          }

          {
            isAiBrief ? (
              <div class="brief-hero__inner">
                <div class="brief-hero__main">
                  <p class="brief-hero__eyebrow">AI 行业 {briefTypeLabel}</p>
                  <h1>{title}</h1>
                  <p class="brief-hero__desc">
                    {metaDescription}
                  </p>
                  <div class="brief-hero__meta">
                    <span>📅 {formatDate(date)}</span>
                    <span>📊 {newsCount || 0} 条摘要</span>
                    <span>⏱ {readTime} 分钟</span>
                    <span>状态：{briefStatusLabel}</span>
                  </div>
                </div>
                <div class="brief-hero__panel">
                  <div class="brief-hero__panel-title">中文摘要</div>
                  <p>{metaDescription}</p>
                  <div class="brief-hero__panel-note">
                    内容来自多站采集，按早报 / 晚报整理。
                  </div>
                </div>
              </div>
            ) : (
              <>
                <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.8rem;
                  line-height: 1.4;">
                  {title}
                </h1>

                <div style="color: var(--color-text-light); font-size: 0.9rem;
                  display: flex; align-items: center; justify-content: center;
                  gap: 1rem; flex-wrap: wrap; margin-bottom: 0.8rem;">
                  <span>📅 {formatDate(date)}</span>
                  {
                    category && (
                      <span>📂 {category}</span>
                    )
                  }
                  <span>⏱ 阅读约 {readTime} 分钟</span>
                </div>

                {
                  tags.length > 0 && (
                    <div style="display: flex; justify-content: center; margin-top: 0.5rem;">
                      <TagList tags={tags} />
                    </div>
                  )
                }
              </>
            )
          }
        </header>

        <!-- 文章正文 -->
        <div class={`article-content ${isAiBrief ? 'article-content--brief' : ''}`}>
          <slot />
        </div>

        <!-- 文章底部导航 -->
        <div style="margin-top: 3rem; text-align: center;">
          <a href={`${base}${collection}/`} class="btn btn-outline">
            ← 返回{collectionName}
          </a>
        </div>
      </article>
    </main>

    <Footer />

    <button
      class="back-to-top"
      id="backToTop"
      aria-label="返回顶部"
      title="返回顶部"
    >
      ↑
    </button>
  </body>
</html>

<script>
  const btn = document.getElementById('backToTop');
  if (btn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        btn.classList.add('visible');
      } else {
        btn.classList.remove('visible');
      }
    });

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  .article-hero {
    text-align: center;
  }

  .brief-hero {
    padding: 1.1rem 1rem 1rem;
    background: #fff;
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
  }

  .brief-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.8fr);
    gap: var(--spacing-md);
    align-items: start;
  }

  .brief-hero__eyebrow {
    font-size: 0.8rem;
    color: var(--color-text-light);
    margin-bottom: 0.3rem;
  }

  .brief-hero__main h1 {
    font-size: 1.9rem;
    line-height: 1.35;
    margin-bottom: 0.7rem;
    text-align: left;
  }

  .brief-hero__desc {
    font-size: 0.98rem;
    color: var(--color-text-light);
    line-height: 1.75;
    margin-bottom: 0.9rem;
  }

  .brief-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.8rem;
    color: var(--color-text-light);
    font-size: 0.85rem;
  }

  .brief-hero__panel {
    padding: 0.95rem;
    background: var(--color-primary-light);
    border-radius: 8px;
    border: 1px solid #d6f5df;
  }

  .brief-hero__panel-title {
    font-size: 0.8rem;
    color: var(--color-primary-hover);
    font-weight: 600;
    margin-bottom: 0.45rem;
  }

  .brief-hero__panel p {
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .brief-hero__panel-note {
    margin-top: 0.65rem;
    font-size: 0.78rem;
    color: var(--color-text-light);
  }

  .article-content--brief {
    max-width: 860px;
  }

  .article-content--brief h2 {
    background: #f8fafc;
    padding: 0.7rem 0.85rem;
    border-left: 4px solid var(--color-primary);
    border-bottom: none;
    border-radius: 8px;
  }

  .article-content--brief h3 {
    margin-top: 1.2rem;
  }

  .article-content--brief ul,
  .article-content--brief ol {
    padding-left: 1.2rem;
  }

  .article-content--brief li {
    margin-bottom: 0.55rem;
  }

  @media (max-width: 760px) {
    .brief-hero__inner {
      grid-template-columns: 1fr;
    }

    .brief-hero__main h1 {
      font-size: 1.5rem;
    }
  }
</style>
