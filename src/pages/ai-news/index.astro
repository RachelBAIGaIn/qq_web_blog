---
/**
 * AI 资讯列表页
 * 展示最新早报/晚报和日报归档
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import AINewsBriefBanner from '@components/AINewsBriefBanner.astro';
import { getDailyBriefs } from '@utils/posts';
import { formatDate } from '@utils/formatDate';

// base 路径：开发时为 /，Gitee Pages 部署时为 /qq_web_blog/
const base = import.meta.env.BASE_URL === '/' ? '/' : import.meta.env.BASE_URL + '/';

const { latestMorning, latestEvening, briefs } = await getDailyBriefs();

// 最近30天的日报
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
const recentBriefs = briefs
  .filter((b) => new Date(b.data.date) >= thirtyDaysAgo)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function briefTypeLabel(brief: any): string {
  return brief.data.briefType === 'evening' ? '晚报' : '早报';
}

function briefTypeIcon(brief: any): string {
  return brief.data.briefType === 'evening' ? '🌇' : '🌅';
}

function briefStatusText(brief: any): string {
  if (!brief) { return '暂无'; }
  const status = brief.data.status || 'published';
  if (status === 'draft' || status === 'review') { return '待审核'; }
  return '已更新';
}

function briefStatusClass(brief: any): string {
  if (!brief) { return 'status-empty'; }
  const status = brief.data.status || 'published';
  if (status === 'draft' || status === 'review') { return 'status-review'; }
  return 'status-published';
}

function briefSummary(brief: any): string {
  return brief?.data?.description?.trim() || '暂无中文摘要。';
}

function shortDate(dateStr: string): string {
  const d = new Date(dateStr);
  return `${d.getFullYear()}.${d.getMonth() + 1}.${d.getDate()}`;
}

// 最近更新时间
const now = new Date();
const updateTimeHint = `页面更新时间: ${formatDate(now.toISOString())} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
---

<BaseLayout
  title="AI 相关资讯"
  description="早报、晚报和 AI 新闻摘要，按中文简报方式聚合展示"
>
  <section class="news-hero">
    <div class="news-hero__main">
      <p class="news-hero__eyebrow">AI 行业早报 / 晚报</p>
      <h1 class="news-hero__title">AI 相关资讯</h1>
      <p class="news-hero__desc">
        聚合各网站的 AI 新闻，优先呈现早报和晚报的中文摘要，方便快速浏览当天重点。
      </p>
      <div class="news-hero__meta">
        <span>今日简报 {briefs.length} 期</span>
        <span>{updateTimeHint}</span>
      </div>
    </div>

    <div class="news-hero__stats">
      <div class="hero-stat">
        <span class="hero-stat__label">早报</span>
        <strong class="hero-stat__value">
          {latestMorning ? formatDate(latestMorning.data.date) : '待更新'}
        </strong>
        <small>{latestMorning ? `${latestMorning.data.newsCount || 0} 条摘要` : '08:00 自动生成'}</small>
      </div>
      <div class="hero-stat">
        <span class="hero-stat__label">晚报</span>
        <strong class="hero-stat__value">
          {latestEvening ? formatDate(latestEvening.data.date) : '待更新'}
        </strong>
        <small>{latestEvening ? `${latestEvening.data.newsCount || 0} 条摘要` : '20:00 自动生成'}</small>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="section-block__head">
      <h2 class="section-title">今日简报</h2>
      <p class="section-block__sub">早报和晚报优先展示中文摘要，点开可看完整正文。</p>
    </div>
    <AINewsBriefBanner morning={latestMorning} evening={latestEvening} />
  </section>

  {
    recentBriefs.length > 0 && (
      <section class="section-block">
        <div class="section-block__head">
          <h2 class="section-title">最近 30 天日报</h2>
          <p class="section-block__sub">按日期查看早报和晚报归档。</p>
        </div>
        <div class="brief-archive">
          {
            recentBriefs.map((brief) => {
              const status = brief.data.status || 'published';
              return (
                <a href={`${base}ai-news/${brief.slug}/`} class="brief-archive__item">
                  <div class="brief-archive__date">
                    <span class="brief-archive__icon">{briefTypeIcon(brief)}</span>
                    <strong>{shortDate(brief.data.date)}</strong>
                    <span>{briefTypeLabel(brief)}</span>
                  </div>
                  <div class="brief-archive__body">
                    <h3>{brief.data.title}</h3>
                    <p>{briefSummary(brief)}</p>
                    <div class="brief-archive__meta">
                      <span>{brief.data.newsCount || 0} 条摘要</span>
                      <span class={`brief-status ${status === 'draft' || status === 'review' ? 'status-review' : 'status-published'}`}>
                        {briefStatusText(brief)}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>
      </section>
    )
  }

</BaseLayout>

<style>
  .news-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.9fr);
    gap: var(--spacing-lg);
    padding: 1.25rem 0 1.5rem;
    margin-bottom: var(--spacing-lg);
  }

  .news-hero__main {
    min-width: 0;
  }

  .news-hero__eyebrow {
    font-size: 0.8rem;
    color: var(--color-text-light);
    margin-bottom: 0.35rem;
  }

  .news-hero__title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.65rem;
  }

  .news-hero__desc {
    color: var(--color-text-light);
    max-width: 42rem;
    line-height: 1.75;
    margin-bottom: 0.9rem;
  }

  .news-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: var(--color-text-light);
    font-size: 0.85rem;
  }

  .news-hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    align-self: stretch;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.35rem;
    padding: 1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
  }

  .hero-stat__label {
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .hero-stat__value {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .hero-stat small {
    font-size: 0.78rem;
    color: var(--color-text-light);
  }

  .section-block {
    margin-bottom: var(--spacing-xl);
  }

  .section-block__head {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-md);
    align-items: flex-end;
    margin-bottom: var(--spacing-md);
  }

  .section-block__sub {
    font-size: 0.86rem;
    color: var(--color-text-light);
  }

  .brief-archive {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .brief-archive__item {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--spacing-md);
    padding: 0.95rem 1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .brief-archive__item:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .brief-archive__date {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    color: var(--color-text-light);
    min-width: 0;
  }

  .brief-archive__icon {
    font-size: 1rem;
  }

  .brief-archive__date strong {
    color: var(--color-text);
    font-size: 1rem;
  }

  .brief-archive__body {
    min-width: 0;
  }

  .brief-archive__body h3 {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 0.35rem;
  }

  .brief-archive__body p {
    color: var(--color-text-light);
    font-size: 0.88rem;
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .brief-archive__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    color: var(--color-text-light);
    font-size: 0.78rem;
  }

  .brief-status {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.45rem;
    border-radius: 8px;
    font-weight: 500;
  }

  .status-published {
    background-color: #e6fffa;
    color: #234e52;
  }

  .status-review {
    background-color: #fefcbf;
    color: #744210;
  }

  .status-empty {
    background-color: #edf2f7;
    color: #718096;
  }

  @media (max-width: 860px) {
    .news-hero {
      grid-template-columns: 1fr;
    }

    .news-hero__stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 700px) {
    .section-block__head {
      flex-direction: column;
      align-items: flex-start;
    }

    .brief-archive__item {
      grid-template-columns: 1fr;
    }

    .news-hero__title {
      font-size: 1.6rem;
    }
  }
</style>
